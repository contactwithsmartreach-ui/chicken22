<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <linearGradient id="bgGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#520f02" />
      <stop offset="35%" stop-color="#681403" />
      <stop offset="70%" stop-color="#8b1e06" />
      <stop offset="100%" stop-color="#3d0a00" />
    </linearGradient>
    <linearGradient id="goldGrad2" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FFF4D0" />
      <stop offset="40%" stop-color="#EFB11D" />
      <stop offset="80%" stop-color="#FDE047" />
      <stop offset="100%" stop-color="#C9890C" />
    </linearGradient>
    <radialGradient id="glowRed2" cx="20%" cy="30%" r="60%">
      <stop offset="0%" stop-color="#E43D12" stop-opacity="0.4" />
      <stop offset="100%" stop-color="#E43D12" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="glowGold2" cx="80%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#EFB11D" stop-opacity="0.35" />
      <stop offset="100%" stop-color="#EFB11D" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="cardGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.12" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0.5" />
    </linearGradient>
    <linearGradient id="borderGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#EFB11D" stop-opacity="0.6" />
      <stop offset="50%" stop-color="#FFA2B6" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#EFB11D" stop-opacity="0.2" />
    </linearGradient>
    <filter id="cardShadow2" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="24" stdDeviation="30" flood-color="#000000" flood-opacity="0.6" />
    </filter>
  </defs>

  <style>
    .serif-title { font-family: 'Playfair Display', 'Georgia', serif; font-weight: 700; }
    .sans-text { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
  </style>

  <rect width="1200" height="630" fill="url(#bgGrad2)" />
  <circle cx="200" cy="180" r="350" fill="url(#glowRed2)" />
  <circle cx="950" cy="280" r="400" fill="url(#glowGold2)" />

  <circle cx="960" cy="315" r="240" fill="none" stroke="#EFB11D" stroke-opacity="0.18" stroke-width="1.5" />
  <circle cx="960" cy="315" r="180" fill="none" stroke="#FFA2B6" stroke-opacity="0.15" stroke-width="1" stroke-dasharray="6,6" />

  <g filter="url(#cardShadow2)">
    <rect x="730" y="95" width="410" height="440" rx="32" fill="url(#cardGrad2)" stroke="url(#borderGrad2)" stroke-width="1.5" />
    <rect x="755" y="120" width="360" height="230" rx="20" fill="#1e0703" />
    <circle cx="935" cy="235" r="70" fill="#E43D12" fill-opacity="0.4" />
    <circle cx="935" cy="235" r="45" fill="#EFB11D" fill-opacity="0.6" />
    <circle cx="935" cy="235" r="24" fill="#FFF4D0" />
    
    <rect x="755" y="375" width="130" height="26" rx="13" fill="#EFB11D" fill-opacity="0.2" stroke="#EFB11D" stroke-opacity="0.5" />
    <text x="820" y="392" text-anchor="middle" class="sans-text" font-size="11" font-weight="700" fill="#EFB11D" letter-spacing="1.5">HAUTE CUISINE</text>
    <text x="755" y="432" class="serif-title" font-size="22" fill="#FFFFFF">A5 Wagyu Striploin</text>
    <text x="755" y="458" class="sans-text" font-size="13" fill="#EBE9E1" opacity="0.75">Bone Marrow Jus & 3D Projection Symphony</text>
    <text x="1080" y="432" text-anchor="end" class="serif-title" font-size="22" fill="#EFB11D" font-weight="700">$128</text>
  </g>

  <g transform="translate(80, 110)">
    <rect x="0" y="0" width="310" height="38" rx="19" fill="#EFB11D" fill-opacity="0.15" stroke="#EFB11D" stroke-opacity="0.4" />
    <circle cx="20" cy="19" r="4" fill="#EFB11D" />
    <text x="36" y="24" class="sans-text" font-size="12" font-weight="700" fill="#EFB11D" letter-spacing="2">MICHELIN THREE-STAR SALON</text>
  </g>

  <text x="80" y="240" class="serif-title" font-size="78" fill="url(#goldGrad2)" letter-spacing="4">L'ÉLIXIR</text>
  <text x="80" y="320" class="serif-title" font-size="44" fill="#FFFFFF" font-weight="400">Where Haute Cuisine Meets</text>
  <text x="80" y="375" class="serif-title" font-size="44" fill="#EFB11D" font-style="italic">3D Digital Artistry.</text>

  <text x="80" y="430" class="sans-text" font-size="18" fill="#EBE9E1" opacity="0.82" font-weight="300">
    An avant-garde multi-sensory fine dining odyssey orchestrated
  </text>
  <text x="80" y="458" class="sans-text" font-size="18" fill="#EBE9E1" opacity="0.82" font-weight="300">
    with synchronized spatial projections and alchemical gastronomy.
  </text>

  <g transform="translate(80, 505)">
    <text x="0" y="24" class="serif-title" font-size="28" font-weight="700" fill="url(#goldGrad2)">3 Stars</text>
    <text x="0" y="42" class="sans-text" font-size="11" fill="#EBE9E1" opacity="0.6" letter-spacing="1.5">MICHELIN GUIDE</text>
    <line x1="130" y1="5" x2="130" y2="45" stroke="#ffffff" stroke-opacity="0.2" />
    <text x="160" y="24" class="serif-title" font-size="28" font-weight="700" fill="url(#goldGrad2)">12 Courses</text>
    <text x="160" y="42" class="sans-text" font-size="11" fill="#EBE9E1" opacity="0.6" letter-spacing="1.5">SENSORY JOURNEY</text>
    <line x1="310" y1="5" x2="310" y2="45" stroke="#ffffff" stroke-opacity="0.2" />
    <text x="340" y="24" class="serif-title" font-size="28" font-weight="700" fill="url(#goldGrad2)">Paris 75008</text>
    <text x="340" y="42" class="sans-text" font-size="11" fill="#EBE9E1" opacity="0.6" letter-spacing="1.5">PRIVATE SALON</text>
  </g>

  <rect x="0" y="622" width="1200" height="8" fill="url(#goldGrad2)" />
</svg>